# Free key from https://aistudio.google.com/apikey  (copy this file to .env)
GOOGLE_API_KEY=

# Optional overrides
# GEMINI_MODEL=models/gemini-3.8-live
# GEMINI_VOICE=Aoede        # Puck, Charon, Kore, Fenrir, Aoede
# PORT=7860
# CYNO_LANGUAGES=en-US      # add ,si-LK when Sinhala is turned on
# OLLAMA_MODEL=llama3.2:3b  # offline brain; llama3.2:1b is faster
# WHISPER_MODEL=small.en    # offline ears; base.en is faster
# KOKORO_VOICE=af_heart     # offline voice
# CYNO_FORCE_OFFLINE=1      # rehearse offline mode
